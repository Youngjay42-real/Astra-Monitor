# Neon Postgres (Render Web Service + local)
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.neon.tech/neondb?sslmode=require

# Comma-separated frontend origins (Render static URL + local Vite)
CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.onrender.com

CREW_NAME=Sim Crew A
MISSION_DAY=42
NASA_CACHE_TTL_SECONDS=900

# NASA Open APIs — DONKI SEP space weather for radiation / crew health context
# Get a free key at https://api.nasa.gov (DEMO_KEY works for light local demos)
NASA_API_KEY=

# xAI Grok — camera observe + mission chat (https://console.x.ai)
XAI_API_KEY=
GROK_MODEL=grok-4.7
